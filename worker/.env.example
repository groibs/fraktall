SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
FRAKTALL_WORKER_ID=fraktall-vps
POLL_SECONDS=3

# Analysis (long-form segmentation + Shorts selection).
# Default provider is OpenAI — this worker is meant to run unattended on a
# server (VPS), so it doesn't assume a local LM Studio is reachable.
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Transcription (used only when no YouTube caption track is found).
TRANSCRIPTION_PROVIDER=openai
OPENAI_TRANSCRIBE_MODEL=whisper-1

# Optional: point at a local LM Studio / Whisper instead (e.g. running this
# worker on your own machine during development). See docs/DEPLOY_VPS.md
# for the cloud-only setup this repo is built around.
# LLM_PROVIDER=lmstudio
# LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
# LMSTUDIO_MODEL=qwen/qwen3-1.7b
# TRANSCRIPTION_PROVIDER=whisper_local
# WHISPER_BASE_URL=http://127.0.0.1:8178/v1
# WHISPER_MODEL=small
WHISPER_LANGUAGE=pt

# Set to 0 to skip rendering downloadable clips (curation-only, faster).
# Needs a "clips" bucket in Supabase Storage — see docs/WEB_WORKER_MVP.md.
RENDER_CLIPS=1
