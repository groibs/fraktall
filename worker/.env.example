SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
FRAKTALL_WORKER_ID=lucas-pc
POLL_SECONDS=3

# Analysis (long-form segmentation + Shorts selection)
LLM_PROVIDER=lmstudio
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LMSTUDIO_MODEL=qwen/qwen3-1.7b
# Set LLM_PROVIDER=openai and fill these to use OpenAI instead of LM Studio:
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Transcription (used only when no YouTube caption track is found)
TRANSCRIPTION_PROVIDER=whisper_local
WHISPER_BASE_URL=http://127.0.0.1:8178/v1
WHISPER_MODEL=small
WHISPER_LANGUAGE=pt
# Set TRANSCRIPTION_PROVIDER=openai (needs OPENAI_API_KEY above) to use
# OpenAI's transcription API instead of local Whisper:
# OPENAI_TRANSCRIBE_MODEL=whisper-1

# Set to 0 to skip rendering downloadable clips (curation-only, faster).
# Needs a "clips" bucket in Supabase Storage — see docs/WEB_WORKER_MVP.md.
RENDER_CLIPS=1
