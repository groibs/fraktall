{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fraktall.local/schemas/job.schema.json",
  "title": "Fraktall Automation Job",
  "type": "object",
  "additionalProperties": false,
  "required": ["source", "analysis", "output"],
  "properties": {
    "id": { "type": "string" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "provider": { "type": "string", "enum": ["youtube", "twitch", "vimeo", "tiktok", "file", "other"] },
        "channelId": { "type": "string" },
        "channelName": { "type": "string" },
        "sourceVideoId": { "type": "string" },
        "rightsProfile": { "type": "string" },
        "discoveredAt": { "type": "string", "format": "date-time" }
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "curationMode": { "type": "string", "enum": ["viral", "podcast", "insight", "news", "institutional", "custom"], "default": "podcast" },
        "customPrompt": { "type": "string" },
        "clipCount": { "type": "integer", "minimum": 1, "maximum": 100, "default": 10 },
        "minDurationSec": { "type": "integer", "minimum": 5, "default": 20 },
        "maxDurationSec": { "type": "integer", "minimum": 10, "maximum": 180, "default": 90 },
        "minSelectionScore": { "type": "integer", "minimum": 0, "maximum": 99, "default": 65 },
        "minContextIntegrityScore": { "type": "integer", "minimum": 0, "maximum": 99, "default": 75 },
        "speakerFraming": { "type": "string", "enum": ["auto", "speaker", "duo", "dynamic", "manual"], "default": "auto" },
        "captions": { "type": "boolean", "default": true },
        "tightenCuts": { "type": "boolean", "default": true },
        "autoZoom": { "type": "boolean", "default": true }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "aspectRatios": {
          "type": "array",
          "items": { "type": "string", "enum": ["9:16", "1:1", "16:9"] },
          "minItems": 1,
          "uniqueItems": true,
          "default": ["9:16"]
        },
        "writeMetadataJson": { "type": "boolean", "default": true },
        "writeSrt": { "type": "boolean", "default": true },
        "publishMode": { "type": "string", "enum": ["none", "draft", "auto"], "default": "none" },
        "destinations": {
          "type": "array",
          "items": { "type": "string", "enum": ["youtube-shorts", "tiktok", "instagram-reels"] },
          "uniqueItems": true
        }
      }
    },
    "feedback": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "collectMetrics": { "type": "boolean", "default": true },
        "checkpointsHours": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 },
          "uniqueItems": true,
          "default": [1, 6, 24, 72, 168]
        },
        "learningProfile": { "type": "string", "default": "default" }
      }
    }
  }
}
